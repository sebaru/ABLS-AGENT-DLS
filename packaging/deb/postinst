#!/bin/sh
set -eu

if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  systemctl daemon-reload >/dev/null 2>&1 || true
  if systemctl is-active --quiet abls-agent-dls.service 2>/dev/null; then
    systemctl try-restart abls-agent-dls.service >/dev/null 2>&1 || true
  fi
fi

exit 0
