#!/bin/sh
set -eu

if ! getent group abls >/dev/null 2>&1; then
  groupadd --system abls
fi

if ! getent passwd abls-agent-dls >/dev/null 2>&1; then
  useradd --system --gid abls --no-create-home --shell /sbin/nologin abls-agent-dls
fi

if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0
